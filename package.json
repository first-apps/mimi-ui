{
  "name": "@first-apps/mimi-ui",
  "version": "1.0.4",
  "description": "Reusable web components across JavaScript frameworks",
  "type": "module",
  "license": "MIT",
  "author": "@dikshit-n",
  "homepage": "https://github.com/first-apps/mimi-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/first-apps/mimi-ui.git"
  },
  "bugs": {
    "url": "https://github.com/first-apps/mimi-ui/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "lit-element",
    "typescript",
    "design-system",
    "ui",
    "mimi",
    "mimi-ui",
    "react",
    "angular",
    "vue",
    "svelte"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": ["**/*.scss", "**/m-*.ts"],
  "main": "./dist/mimi-ui.cjs.js",
  "module": "./dist/mimi-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mimi-ui.es.js",
      "require": "./dist/mimi-ui.cjs.js",
      "default": "./dist/mimi-ui.es.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm run build:storybook && storybook dev -p 6006",
    "build": "tsc && vite build --mode production",
    "build:dev": "tsc && vite build --mode development --outDir dist-dev",
    "build:prod": "tsc && vite build --mode production",
    "preview": "npm run build:storybook && vite preview --outDir storybook-static --port 6007 --strictPort",
    "clean": "rm -rf dist dist-dev storybook-static",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:storybook": "storybook build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^21.0.3",
    "sass": "^1.105.2",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
