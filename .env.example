# @first-apps/mimi-ui environment template — copy to `.env.local` and override.
# Loaded automatically by Vite for `vite`, `vite build`, `vite preview`.
# All values here are baked into the published bundle at build time.

# Which environment this build targets: `development` | `production`
VITE_BUILD_ENV=development

# Console log level exposed to components: `debug` | `info` | `warn` | `error`
VITE_LOG_LEVEL=debug

# Toggle dev-only console warnings (a11y hints, deprecations): `true` | `false`
VITE_SHOW_DEV_WARNINGS=true

# Demo URL advertised in storybook / preview pages
VITE_DEMO_URL=http://localhost:6006
